---
import '../styles/global.css';
import { absoluteUrl, siteName, siteDescription, withBase } from '../lib/site';
interface Props {
  title?: string;
  description?: string;
  /** 当前页面路径，用于 canonical 与分享链接；缺省取 Astro.url.pathname。 */
  path?: string;
  /** 分享卡片图，缺省使用 1200x630 的站点分享卡。 */
  image?: string;
  /** 不需要被索引的页面（如 404）。 */
  noindex?: boolean;
  /** 详情页额外注入的结构化数据。 */
  structuredData?: Record<string, unknown>;
}
const {
  title = siteName,
  description = siteDescription,
  path = Astro.url.pathname,
  image = withBase('brand/og.png'),
  noindex = false,
  structuredData,
} = Astro.props;
const canonical = new URL(path, absoluteUrl()).href;
const ogImage = new URL(image, absoluteUrl()).href;
const ogType = structuredData ? 'article' : 'website';
const jsonLd = structuredData
  ? JSON.stringify({ '@context': 'https://schema.org', ...structuredData })
  : undefined;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f7f2e5" />
    <link rel="canonical" href={canonical} />
    <link
      rel="icon"
      href={withBase('favicon.ico')}
      sizes="16x16 24x24 32x32 48x48 64x64 128x128 256x256"
    />
    <link rel="icon" type="image/svg+xml" href={withBase('favicon.svg')} />
    <link rel="apple-touch-icon" sizes="180x180" href={withBase('apple-touch-icon.png')} />
    <link
      rel="preload"
      href={withBase('fonts/MHRounded.woff2')}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link rel="stylesheet" href={withBase('fonts/rounded.css')} />
    <link rel="stylesheet" href={withBase('styles/scrollbars.css')} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {noindex && <meta name="robots" content="noindex" />}
    <title>{title}</title>
    {jsonLd && <script type="application/ld+json" set:html={jsonLd} />}
  </head>
  <body>
    <a class="skip-link" href="#main">
      跳转到正文
    </a>
    <main id="main">
      <slot />
    </main>
  </body>
</html>
