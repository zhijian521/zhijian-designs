---
import type { CollectionEntry } from 'astro:content';
import { withBase } from '../lib/paths';
import { readPublicImageSize } from '../lib/imageSize';
interface Props {
  design: CollectionEntry<'designs'>;
}
const { design } = Astro.props;
const { data, id } = design;
// 真实尺寸只用于声明 width/height 防止图片加载前布局跳动；
// 展示比例统一由 CSS 的 3:2 决定，避免不同来源的封面把卡片撑成不同高度。
const cover = readPublicImageSize(data.cover);
---

<article class="design-card">
  <a class="card-cover" href={withBase(`archive/${id}/`)} aria-label={`查看${data.title}`}>
    <img
      src={withBase(data.cover)}
      alt={`${data.title}界面封面`}
      width={cover.width}
      height={cover.height}
      loading="lazy"
    />
  </a>
  <div class="card-meta">
    <span>
      {data.category} · {data.version}
    </span>
    <time datetime={data.date}>{data.date.replaceAll('-', '.')}</time>
  </div>
  <h2>
    <a href={withBase(`archive/${id}/`)}>{data.title}</a>
  </h2>
  <p>{data.description}</p>
  <div class="tags">
    {data.tags.map((tag) => (
      <span>{tag}</span>
    ))}
  </div>
</article>
