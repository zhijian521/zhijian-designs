---
interface Props {
  src: string;
  title: string;
}
const { src, title } = Astro.props;
---

<section class="preview-section" aria-labelledby="preview-title">
  <div class="preview-heading">
    <h2 id="preview-title">预览</h2>
    <a class="text-link" href={src} target="_blank" rel="noopener noreferrer">
      独立打开 ↗
    </a>
  </div>
  <div class="preview-shell">
    <div class="preview-toolbar">
      <div role="group" aria-label="预览宽度" class="device-controls">
        <button type="button" data-width="100%" aria-pressed="true">
          自适应
        </button>
        <button type="button" data-width="1440px" aria-pressed="false">
          桌面
        </button>
        <button type="button" data-width="768px" aria-pressed="false">
          平板
        </button>
        <button type="button" data-width="390px" aria-pressed="false">
          手机
        </button>
      </div>
      <span id="preview-width" aria-live="polite">
        100%
      </span>
    </div>
    <div class="preview-stage">
      <iframe
        id="design-preview"
        src={src}
        title={`${title}的独立界面预览`}
        loading="lazy"
        style="width:100%"
      ></iframe>
    </div>
  </div>
</section>
<script>
  const frame = document.querySelector<HTMLIFrameElement>('#design-preview')!;
  const controls = document.querySelectorAll<HTMLButtonElement>('[data-width]');
  controls.forEach((button) =>
    button.addEventListener('click', () => {
      const width = button.dataset.width!;
      frame.style.width = width;
      document.querySelector('#preview-width')!.textContent =
        width === '100%' ? '100%' : width.replace('px', ' px');
      controls.forEach((control) =>
        control.setAttribute('aria-pressed', String(control === button)),
      );
    }),
  );
</script>
