---
import type { CollectionEntry } from 'astro:content';
import DesignCard from './DesignCard.astro';
import BackLink from './BackLink.astro';
import { withBase } from '../lib/paths';
import { volumeOf } from '../lib/designs';
interface Props {
  designs: CollectionEntry<'designs'>[];
  total: number;
  page?: number;
  nextPage?: number;
}
const { designs, total, page = 1, nextPage } = Astro.props;
const PAGE_SIZE = 12;
---

<section class="collection shell" id="collection" aria-labelledby="collection-title">
  <div class="runhead">
    <span>知 简 · 设 计 集</span>
    <span>
      {page > 1 ? '第 ' + page + ' 页 ／ 共 ' + total + ' 册' : '卷 壹 ／ 共 ' + total + ' 册'}
    </span>
  </div>
  {page > 1 && <BackLink />}
  <header class="masthead">
    <span class="seal" aria-hidden="true">
      知简
    </span>
    <div>
      <h1 id="collection-title">设计收藏</h1>
      <p class="lede">博客、网站与工具的界面存档。</p>
    </div>
  </header>
  <div class="rule"></div>
  <ol class="entries">
    {designs.map((design, index) => (
      <DesignCard design={design} volume={volumeOf((page - 1) * PAGE_SIZE + index)} />
    ))}
  </ol>
  {total === 0 && <p class="empty-state">暂无设计</p>}
  {nextPage ? (
    <div class="load-more" data-pagination>
      <a class="text-link" data-next-page href={withBase('page/' + nextPage + '/')} rel="next">
        继 续 翻 阅
      </a>
      <p data-load-status role="status"></p>
    </div>
  ) : (
    total > 0 && <div class="colophon">全 卷 终</div>
  )}
</section>
<script>
  const grid = document.querySelector<HTMLElement>('.entries');
  const pagination = document.querySelector<HTMLElement>('[data-pagination]');
  const link = pagination?.querySelector<HTMLAnchorElement>('[data-next-page]');
  const status = pagination?.querySelector<HTMLElement>('[data-load-status]');

  function initializePagination(
    grid: HTMLElement,
    pagination: HTMLElement,
    link: HTMLAnchorElement,
    status: HTMLElement,
  ) {
    let loading = false;
    let finished = false;
    const observer =
      'IntersectionObserver' in window
        ? new IntersectionObserver(
            (entries) => {
              if (entries.some((entry) => entry.isIntersecting)) void loadNextPage();
            },
            { rootMargin: '300px' },
          )
        : undefined;

    async function loadNextPage() {
      if (loading || finished) return;
      loading = true;
      // 请求期间停止观察；失败后只接受手动重试，避免反复自动请求。
      observer?.disconnect();
      link.textContent = '翻 阅 中 …';
      link.setAttribute('aria-disabled', 'true');
      status.textContent = '';
      grid.setAttribute('aria-busy', 'true');
      try {
        const response = await fetch(link.href, { signal: AbortSignal.timeout(15_000) });
        if (!response.ok) throw new Error('HTTP ' + response.status);
        const nextPage = new DOMParser().parseFromString(await response.text(), 'text/html');
        const cards = nextPage.querySelectorAll('.entries > .entry');
        if (cards.length === 0) throw new Error('Missing design cards');
        grid.append(...cards);
        const next = nextPage.querySelector<HTMLAnchorElement>('[data-next-page]');
        if (next) {
          link.href = new URL(next.getAttribute('href')!, response.url).href;
          link.textContent = '继 续 翻 阅';
          status.textContent = '已 展 开 ' + grid.childElementCount + ' 册';
          observer?.observe(pagination);
        } else {
          finished = true;
          link.hidden = true;
          status.textContent = '已 翻 至 卷 末';
        }
      } catch {
        link.textContent = '重 新 翻 阅';
        status.textContent = '加载失败，请点击重试。';
      } finally {
        loading = false;
        link.removeAttribute('aria-disabled');
        grid.removeAttribute('aria-busy');
      }
    }

    link.addEventListener('click', (event) => {
      if (event.ctrlKey || event.metaKey || event.shiftKey || event.altKey) return;
      event.preventDefault();
      void loadNextPage();
    });
    observer?.observe(pagination);
  }

  if (grid && pagination && link && status) initializePagination(grid, pagination, link, status);
</script>
