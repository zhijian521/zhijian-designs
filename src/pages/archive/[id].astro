---
import { getCollection, render } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';
import PreviewFrame from '../../components/PreviewFrame.astro';
import BackLink from '../../components/BackLink.astro';
import { withBase } from '../../lib/paths';
export async function getStaticPaths() {
  return (await getCollection('designs')).map((design) => ({
    params: { id: design.id },
    props: { design },
  }));
}
const { design } = Astro.props;
const { data } = design;
const { Content } = await render(design);
---

<SiteLayout title={`${data.title} — 知简设计集`} description={data.description}>
  <div class="shell detail-page">
    <BackLink />
    <header class="detail-header">
      <h1>{data.title}</h1>
      <p>{data.description}</p>
      <div class="tags">
        {data.tags.map((tag) => (
          <span>{tag}</span>
        ))}
      </div>
    </header>
    <dl class="design-facts">
      <div>
        <dt>类型</dt>
        <dd>
          {data.category}
          {data.demo && ' · 示例'}
        </dd>
      </div>
      <div>
        <dt>日期</dt>
        <dd>
          <time datetime={data.date}>{data.date}</time>
        </dd>
      </div>
      <div>
        <dt>版本</dt>
        <dd>{data.version}</dd>
      </div>
      <div>
        <dt>配色</dt>
        <dd class="swatches">
          {data.colors.map((color) => (
            <span title={color} aria-label={color} style={{ background: color }}></span>
          ))}
        </dd>
      </div>
    </dl>
    <PreviewFrame src={withBase(data.preview)} title={data.title} />
    <article class="prose detail-notes">
      <Content />
      {data.source && (
        <p>
          <a href={data.source} target="_blank" rel="noopener noreferrer">
            原始仓库 ↗
          </a>
        </p>
      )}
      {data.commit && <p class="commit">提交：{data.commit}</p>}
    </article>
    {data.screenshots.length > 0 && (
      <details class="screenshot-section">
        <summary>
          存档截图 <span>{data.screenshots.length}</span>
        </summary>
        <div class="screenshot-grid">
          {data.screenshots.map((screenshot) => (
            <figure>
              <a href={withBase(screenshot.src)} target="_blank" rel="noopener noreferrer">
                <img src={withBase(screenshot.src)} alt={screenshot.label} loading="lazy" />
              </a>
              <figcaption>{screenshot.label}</figcaption>
            </figure>
          ))}
        </div>
      </details>
    )}
  </div>
</SiteLayout>
