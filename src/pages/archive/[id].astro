---
import { getCollection, render } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';
import PreviewFrame from '../../components/PreviewFrame.astro';
import BackLink from '../../components/BackLink.astro';
import { withBase } from '../../lib/paths';
export async function getStaticPaths() {
  return (await getCollection('designs')).map((design) => ({
    params: { id: design.id },
    props: { design },
  }));
}
const { design } = Astro.props;
const { data } = design;
const { Content } = await render(design);
---

<SiteLayout title={`${data.title} — 知简设计集`} description={data.description}>
  <div class="shell detail-page">
    <BackLink />
    <header class="detail-header">
      <h1>{data.title}</h1>
      <p>{data.description}</p>
      <div class="tags">
        {data.tags.map((tag) => (
          <span>{tag}</span>
        ))}
      </div>
    </header>
    <section class="design-overview" aria-label="作品信息">
      <dl class="design-facts">
        <div>
          <dt>类型</dt>
          <dd>{data.category}</dd>
        </div>
        <div>
          <dt>日期</dt>
          <dd>
            <time datetime={data.date}>{data.date}</time>
          </dd>
        </div>
        <div>
          <dt>版本</dt>
          <dd>{data.version}</dd>
        </div>
      </dl>
      <div class="design-palette">
        <h2>主题配色</h2>
        <ul class="color-cards">
          {data.colors.map((color) => (
            <li>
              <span class="color-chip" style={{ background: color }} aria-hidden="true"></span>
              <span class="color-value">{color}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>
    <PreviewFrame src={withBase(data.preview)} title={data.title} />
    <article class="prose detail-notes">
      <Content />
      {data.source && (
        <p>
          <a href={data.source} target="_blank" rel="noopener noreferrer">
            原始仓库 ↗
          </a>
        </p>
      )}
      {data.commit && <p class="commit">提交：{data.commit}</p>}
    </article>
  </div>
</SiteLayout>
