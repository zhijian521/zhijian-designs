---
import SiteLayout from '../layouts/SiteLayout.astro';
import Gallery from '../components/Gallery.astro';
import { getDesignPages } from '../lib/designs';
import { withBase } from '../lib/paths';
const { pages, total } = await getDesignPages();
const first = pages[0] ?? [];
---

<SiteLayout
  path={withBase()}
  description="在 3D 画廊中环游博客、网站与工具的设计存档，走近真实界面，细看每一份设计。"
>
  <Gallery designs={first} total={total} nextPage={pages.length > 1 ? 2 : undefined} />
</SiteLayout>
